#!/bin/sh /etc/rc.common
# 可选分流同步：只在门户开启且确有受限策略时运行。
START=99
STOP=9
USE_PROCD=1
start_service() {
	. /usr/libexec/portal/devices.sh
	portal_load || return 1
	portal_ext_needed || return 0
	command -v curl >/dev/null || { logger -t identity-portal '可选分流需要安装 curl'; return 1; }
	procd_open_instance sync
	procd_set_param command /etc/portal/portal-sync-unauth
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
stop_service() { /etc/portal/portal-sync-unauth --disable; }
